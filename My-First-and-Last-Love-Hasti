<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>My First and Last Love Hasti</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Vazirmatn:wght@300;400;600;700&display=swap">
<style>
:root{--bg:#F5F0EA;--ink:#17121C;--soft:#6A5F72;--accent:#A5603F;--rule:rgba(23,18,28,.2);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0E0A14;--ink:#F3EDE6;--soft:#A99DB4;--accent:#E2A98B;--rule:rgba(243,237,230,.2)}}
:root[data-theme="dark"]{--bg:#0E0A14;--ink:#F3EDE6;--soft:#A99DB4;--accent:#E2A98B;--rule:rgba(243,237,230,.2)}
*{box-sizing:border-box}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Vazirmatn",Tahoma,sans-serif;font-weight:300;line-height:2;overflow-x:clip}
.en{font-family:"Pinyon Script","Snell Roundhand",cursive;font-weight:400;line-height:1.5;color:var(--accent);direction:ltr;text-align:right}
.fr{direction:ltr;text-align:right;color:var(--soft);font-size:.95rem;line-height:1.9}

.hero{position:relative;min-height:100svh;margin-top:calc(env(safe-area-inset-top,0px)*-1);display:flex;align-items:flex-end;background:#0E0A14;color:#F3EDE6;overflow:hidden}
.bg{position:absolute;inset:0}
.bg::before,.bg::after{content:"";position:absolute;width:90vmax;height:90vmax;border-radius:50%;background:radial-gradient(closest-side,rgba(226,169,139,.38),transparent);animation:drift 22s ease-in-out infinite alternate}
.bg::before{top:-45vmax;right:-35vmax}
.bg::after{bottom:-50vmax;left:-45vmax;background:radial-gradient(closest-side,rgba(110,80,200,.35),transparent);animation-delay:-9s}
.bg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 32%;animation:kb 24s ease-out forwards}
.bg.photo::before,.bg.photo::after{display:none}
.veil{position:absolute;inset:0;background:linear-gradient(to top,rgba(14,10,20,.9),rgba(14,10,20,.05) 58%,rgba(14,10,20,.3))}
.hero-in{position:relative;z-index:2;width:100%;max-width:640px;margin:0 auto;padding:0 24px calc(11vh + env(safe-area-inset-bottom,0px))}
.mini{margin:0;color:#CFC4D9}
.hs{margin:0}.hs.fa{color:#CFC4D9}.hs.en{font-size:1.8rem;color:#E2A98B}.hs.fr{color:#CFC4D9;font-size:.9rem;line-height:1.7}
h1{margin:0;font-weight:700;font-family:"Vazirmatn",Tahoma,sans-serif;font-size:clamp(6.5rem,40vw,15rem);line-height:1.05}
.cue{position:absolute;z-index:2;bottom:0;left:50%;width:1px;height:8vh;background:linear-gradient(#F3EDE6,transparent);transform-origin:top;animation:cue 2.6s ease-in-out infinite}
@keyframes drift{to{transform:translate(6vmax,5vmax) scale(1.1)}}
@keyframes kb{from{transform:scale(1.02)}to{transform:scale(1.1)}}
@keyframes cue{0%{transform:scaleY(0)}60%{transform:scaleY(1);opacity:1}100%{transform:scaleY(1);opacity:0}}

.mems{max-width:640px;margin:0 auto;padding:18vh 24px 0}
.mem{padding:28px 0 16vh;border-top:1px solid var(--rule)}
.meta{margin:0 0 16px;font-size:.9rem;color:var(--accent)}
.ttl.fa{margin:0 0 4px;font-weight:700;font-size:clamp(1.9rem,8.5vw,2.8rem);line-height:1.5}
.ttl.en{margin:0;font-size:2.1rem}
.ttl.fr{margin:0 0 24px}
.tx.fa{margin:0 0 14px;font-size:1.06rem;line-height:2.1}
.tx.en{margin:0 0 12px;font-size:1.45rem}
.tx.fr{margin:0}
.mem figure{margin:0 0 28px;overflow:hidden;border-radius:2px;aspect-ratio:4/5}
.mem img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.07);transition:transform 1.8s cubic-bezier(.2,.7,.2,1)}
.mem.in img{transform:none}
.rv{opacity:0;transform:translateY(24px);transition:opacity 1s,transform 1s cubic-bezier(.2,.7,.2,1)}
.rv.in{opacity:1;transform:none}

.love{position:relative;height:260vh}
.love-in{position:sticky;top:0;height:100svh;max-width:640px;margin:0 auto;padding:0 24px;display:flex;flex-direction:column;justify-content:center;gap:16px}
.lv{display:flex;flex-wrap:wrap;margin:0;gap:0 .3em}
.lv.fa{font-weight:600;font-size:clamp(1.7rem,7vw,2.6rem);line-height:1.8}
.lv.en{justify-content:flex-end;font-size:clamp(1.5rem,6.2vw,2.1rem)}
.lv.fr{justify-content:flex-end}
.w{opacity:.14;transition:opacity .4s}
.w.on{opacity:1}

.end{min-height:90svh;display:grid;place-content:center;justify-items:center;gap:36px;padding:0 24px 12vh;text-align:center}
.end::before{content:"";width:1px;height:12vh;background:var(--accent)}
.cl{margin:0}
.cl.fa{font-size:clamp(2.2rem,10vw,3.4rem);color:var(--accent);font-weight:600;line-height:1.6}
.cl.en{font-size:2.2rem}
.end .en,.end .fr{text-align:center}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}.mem img{transform:none}.w{opacity:1}.love{height:auto;padding:14vh 0}.love-in{position:static;height:auto}}

</style>
</head>
<body>
<header class="hero">
  <div class="bg" id="heroBg"></div>
  <div class="veil"></div>
  <div class="hero-in">
    <p class="mini">برای</p>
    <h1 id="heroName"></h1>
    <div id="heroSub"></div>
  </div>
  <span class="cue"></span>
</header>
<main>
  <section class="mems" id="mems"></section>
  <section class="love" id="love"><div class="love-in" id="loveBox"></div></section>
  <section class="end"><div class="rv" id="endBox"></div></section>
</main>
<script>
// همه‌ی متن‌های سایت اینجاست (فارسی، انگلیسی، فرانسوی). متن فارسی صدای خود صاحب پروژه‌ست.
window.SITE_CONTENT = {
  siteTitle: "My First and Last Love Hasti", // اسم سایت (تب مرورگر و لینک)
  name: "هستی",
  photos: { hero: "data:image/jpeg;base64," }, // عکس اول (موقع build داخل فایل جاسازی می‌شه)
  sub: { fa: "یه چیزی برات ساختم", en: "I made something for you", fr: "J’ai fait quelque chose pour toi" },
  memories: [
    {
      date: "۳۰ دی", // TODO: سال رو بپرس
      photo: "",
      title: { fa: "اولین پیام", en: "The first message", fr: "Le premier message" },
      text: {
        fa: "یادمه اولین باری که بهم پیام دادی ۳۰ دی بود، روزی که اصلاً حال خوبی نداشتم. ولی تو با اومدنت توی زندگیم، از همون روز اول زندگیم رو از این رو به اون رو کردی و باعث شدی همیشه پر انرژی باشم. باعث شدی عاشقی رو تجربه کنم، که با تموم دردهاش چقدر قشنگه و با تموم استرس‌هاش چقدر دوستش داشتم. هنوز که هنوزه روز به روز به این حس اضافه می‌شه و من عاشق‌تر می‌شم.",
        en: "I remember the first time you messaged me. It was the 30th of Dey, a day when I wasn’t doing well at all. But by coming into my life, from that very first day you turned everything upside down and kept me full of energy. You made me experience love, how beautiful it is with all its pains, how much I loved it with all its stress. Even now this feeling grows day by day, and I fall more in love.",
        fr: "Je me souviens de la première fois où tu m’as écrit : c’était le 30 Dey, un jour où j’allais vraiment mal. Mais en entrant dans ma vie, dès ce premier jour, tu as tout bouleversé et tu m’as rempli d’énergie. Tu m’as fait vivre l’amour, si beau malgré toutes ses douleurs, et que j’ai tant aimé malgré tout son stress. Aujourd’hui encore, ce sentiment grandit de jour en jour, et je t’aime un peu plus."
      }
    },
    {
      date: "", // TODO: تاریخ اولین دیدار رو بپرس
      photo: "", // عکس دوم
      title: { fa: "اولین دیدار، کنار پل مارنان", en: "The first meeting, by Marnan Bridge", fr: "La première rencontre, près du pont Marnan" },
      text: {
        fa: "اولین باری که دیدمت کنار پل مارنان بود. خیلی خجالت کشیدم و خیلی استرس داشتم، فکرهای زیادی تو سرم بود. با تموم اون‌ها، وقتی اومدم از کنارت و بهت گفتم «هستی» و برگشتی، توی چشم‌های قشنگت چیزی دیدم که توی چشم‌های هیچ‌کس ندیده بودم. همه‌چیز رو توی چشم‌هات دیدم: اینکه باید چقدر تلاش کنم و چقدر صبور باشم تا بتونم به تو، که خیلی عاشقتم، برسم.",
        en: "The first time I saw you was by Marnan Bridge. I felt so shy and so nervous, my head full of thoughts. Despite all of that, when I came up beside you and said “Hasti” and you turned around, I saw something in your beautiful eyes that I had never seen in anyone else’s. I saw everything in your eyes: how hard I would have to try, how patient I would have to be, to reach you, whom I love so much.",
        fr: "Notre première rencontre a eu lieu près du pont Marnan. Je ressentais une grande timidité et beaucoup de stress, la tête pleine de pensées. Malgré tout cela, quand je me suis approché de toi, que j’ai dit « Hasti » et que tu as tourné la tête, j’ai vu dans tes beaux yeux quelque chose que je n’avais jamais vu dans les yeux de personne. J’y ai tout vu : combien d’efforts et de patience il me faudrait pour te rejoindre, toi que j’aime tant."
      }
    }
    // TODO: خاطره‌ی ۳ تا ۸ رو از صاحب پروژه بگیر
  ],
  love: {
    fa: "من واقعاً بیشتر از چیزی که فکرش رو بکنی دوستت دارم. این حس رو به هیچ چیزی ترجیح نمی‌دم و تا آخر عمرم کنار منه.",
    en: "I truly love you more than you could ever imagine. I wouldn’t trade this feeling for anything, and it will stay with me until the end of my life.",
    fr: "Je t’aime vraiment plus que tu ne peux l’imaginer. Je ne préférerais ce sentiment à rien d’autre, et il restera avec moi jusqu’à la fin de ma vie."
  },
  closing: { fa: "دوستت دارم، هستی.", en: "I love you, Hasti.", fr: "Je t’aime, Hasti." } // TODO: پیام پایانی دلخواه
};

</script>
<script>
(function(){
var C=window.SITE_CONTENT||{},$=function(i){return document.getElementById(i)};
var fa="۰۱۲۳۴۵۶۷۸۹";
function num(n){return String(n).replace(/\d/g,function(d){return fa[d]})}
function el(tag,cls,txt){var e=document.createElement(tag);if(cls)e.className=cls;if(txt)e.textContent=txt;return e}
function trio(parent,o,cls){
  var f=el("p","fa "+cls,o.fa),e=el("p","en "+cls,o.en),r=el("p","fr "+cls,o.fr);
  e.lang="en";e.dir="ltr";r.lang="fr";r.dir="ltr";
  parent.appendChild(f);parent.appendChild(e);parent.appendChild(r);
  return [f,e,r];
}
var name=C.name||"";
document.title=C.siteTitle||name;
$("heroName").textContent=name;
trio($("heroSub"),C.sub,"hs");
if(C.photos&&C.photos.hero){var h=new Image();h.alt="";h.src=C.photos.hero;$("heroBg").appendChild(h);$("heroBg").className="bg photo"}
var box=$("mems");
(C.memories||[]).forEach(function(m,i){
  var a=el("article","mem rv");
  a.appendChild(el("p","meta",num(i<9?"0"+(i+1):i+1)+(m.date?"  —  "+m.date:"")));
  if(m.photo){var f=el("figure"),im=new Image();im.alt="";im.src=m.photo;f.appendChild(im);a.appendChild(f)}
  trio(a,m.title,"ttl");
  trio(a,m.text,"tx");
  box.appendChild(a);
});
var words=[];
trio($("loveBox"),C.love,"lv").forEach(function(p){
  var t=p.textContent;p.textContent="";
  t.split(/\s+/).filter(Boolean).forEach(function(w){var s=el("span","w",w);p.appendChild(s);words.push(s)});
});
trio($("endBox"),C.closing,"cl");
var io=null;
if("IntersectionObserver" in window){io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}})},{threshold:.12})}
Array.prototype.forEach.call(document.querySelectorAll(".rv"),function(n){io?io.observe(n):n.classList.add("in")});
var love=$("love"),tick=false;
function upd(){
  tick=false;
  var r=love.getBoundingClientRect(),span=r.height-window.innerHeight;
  var p=span>0?Math.min(1,Math.max(0,-r.top/span)):1;
  var n=Math.ceil(Math.min(1,p/.85)*words.length);
  words.forEach(function(w,i){w.classList.toggle("on",i<n)});
}
window.addEventListener("scroll",function(){if(!tick){tick=true;requestAnimationFrame(upd)}},{passive:true});
window.addEventListener("resize",upd);upd();
})();

</script>
</body>
</html>
